# Copy to /etc/roostoo/roostoo.env on the EC2 host and chmod 600 it.
# Never commit real credentials.
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=
ROOSTOO_LIVE=0
ROOSTOO_CONFIG=/opt/roostoo/config/live_candidate.json
ROOSTOO_UNIVERSE_CONFIG=/opt/roostoo/config/universe-50.json
# Optional ledger path, embedded in the unit when aws_start.sh runs.
# ROOSTOO_STATE=/opt/roostoo/runs/aws/state.json
