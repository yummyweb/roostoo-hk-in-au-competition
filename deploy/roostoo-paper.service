[Unit]
Description=Roostoo prospective paper research
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/roostoo
ExecStart=/usr/bin/python3 -m roostoo.bot --config config/candidate.json --state /opt/roostoo/runs/paper/state.json
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/roostoo/runs
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
