# Set these in the shell/service environment. Never commit real credentials.
ROOSTOO_API_KEY=
ROOSTOO_API_SECRET=
# Keep paper mode (0) until the account, state and canary are reconciled.
ROOSTOO_LIVE=0
# The AWS launcher points this at the fixed 50-pair research universe.
ROOSTOO_UNIVERSE_CONFIG=config/universe-50.json
ROOSTOO_CONFIG=config/live_candidate.json
